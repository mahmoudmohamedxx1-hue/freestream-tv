<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main theme — dark, Material Design -->
    <style name="Theme.FreeStreamTV" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#E50914</item>
        <item name="colorPrimaryVariant">#B00610</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#E50914</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">#060608</item>
        <item name="colorSurface">#12121A</item>
        <item name="colorOnSurface">#F0F0F0</item>
        <item name="colorError">#E50914</item>
        <item name="android:statusBarColor">#060608</item>
        <item name="android:navigationBarColor">#060608</item>
        <item name="android:windowBackground">#060608</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.FreeStreamTV.Splash" parent="Theme.FreeStreamTV">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Player theme — fullscreen dark -->
    <style name="Theme.FreeStreamTV.Player" parent="Theme.FreeStreamTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
